---
import { SEO } from 'astro-seo';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { dir, uiStrings, type Locale } from '../i18n';
import '../styles/tokens.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	currentPath: string;
	ogImage?: string;
	noindex?: boolean;
}
const { locale, title, description, currentPath, ogImage, noindex } = Astro.props;
const t = uiStrings[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const siteOrigin = (Astro.site ?? new URL('https://odedarbel.com')).origin;
const canonicalUrl = `${siteOrigin}${currentPath}`;

const alternatePath =
	locale === 'he'
		? `/en${currentPath}`
		: currentPath.replace(/^\/en/, '') || '/';
const alternateLocale: Locale = locale === 'he' ? 'en' : 'he';
const alternateUrl = `${siteOrigin}${alternatePath}`;

// Derive slug for OG image: strip /en/ prefix, strip slashes, default to 'home'
const pathSlug =
	currentPath.replace(/^\/en\//, '').replace(/^\/en$/, '').replace(/^\//, '').replace(/\/$/, '') ||
	'home';
const resolvedOgImage = ogImage ?? `${siteOrigin}/og/${locale}-${pathSlug}.png`;
---

<!doctype html>
<html lang={locale} dir={dir[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<SEO
			title={title}
			titleTemplate={`%s | ${t.siteName}`}
			description={description}
			canonical={canonicalUrl}
			noindex={noindex}
			openGraph={{
				basic: {
					title: title,
					type: 'website',
					image: resolvedOgImage,
					url: canonicalUrl,
				},
				optional: {
					description: description,
					locale: locale === 'he' ? 'he_IL' : 'en_US',
					siteName: t.siteName,
				},
				image: {
					width: 1200,
					height: 630,
					alt: title,
				},
			}}
			twitter={{
				card: 'summary_large_image',
				title: title,
				description: description,
				image: resolvedOgImage,
			}}
			extend={{
				link: [
					{ rel: 'alternate', hreflang: locale, href: canonicalUrl },
					{ rel: 'alternate', hreflang: alternateLocale, href: alternateUrl },
					{ rel: 'alternate', hreflang: 'x-default', href: `${siteOrigin}/` },
				],
			}}
		/>
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon.png`} />
		<link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192.png`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Frank+Ruhl+Libre:wght@400;500;700&family=Inter:wght@400;500;600&family=Assistant:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">{t.skipToContent}</a>
		<Nav locale={locale} currentPath={currentPath} />
		<main id="main-content">
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
