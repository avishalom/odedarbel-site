---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { dir, uiStrings, type Locale } from '../i18n';
import '../styles/tokens.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	currentPath: string;
}
const { locale, title, description, currentPath } = Astro.props;
const t = uiStrings[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang={locale} dir={dir[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon.png`} />
		<link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192.png`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<title>{title} | {t.siteName}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Frank+Ruhl+Libre:wght@400;500;700&family=Inter:wght@400;500;600&family=Assistant:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">{t.skipToContent}</a>
		<Nav locale={locale} currentPath={currentPath} />
		<main id="main-content">
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
