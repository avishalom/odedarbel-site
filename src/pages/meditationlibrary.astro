---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordGate from '../components/PasswordGate.astro';
import { pageSeo } from '../seo';
const seo = pageSeo.he['/meditationlibrary'];
---

<BaseLayout
	locale="he"
	currentPath="/meditationlibrary"
	title={seo.lockedTitle ?? seo.title}
	description={seo.lockedDescription ?? seo.description}
	noindex={seo.noindex}
>
	<PasswordGate locale="he" />
</BaseLayout>
