---
import ProsePage from '../components/ProsePage.astro';
import PillButton from '../components/PillButton.astro';
import { withBase } from '../i18n';
---

<ProsePage
	locale="he"
	currentPath="/meditationpractice"
	title="תירגול מדיטציה"
	description="תירגול מדיטציה — קבוצות, ספריית הקלטות מודרכות, וגישה בודהיסטית לנוכחות."
>
	<p>מזה אלפי שנים, במגוון מסורות רוחניות, ישבו אנשים לשהייה פשוטה ונוכחת ברגע הזה.</p>
	<p>
		מדיטציה היא תירגול פשוט, למרות שלא תמיד קל — התחייבות לשבת לפרק זמן קבוע ולהתבונן ללא שיפוט
		וללא תגובה.
	</p>
	<p>
		הישיבה עם קבוצה ומנחה מביאה עמה יתרון רב, ומחזקת את ההתמדה ומאפשרת להתמודד עם קשיים דרך שיחה
		משותפת.
	</p>
	<p><strong>סנגהה</strong> — קבוצת אנשים המתרגלת יחד ותומכת זה בזה בתהליך הלימוד וההתפתחות.</p>
	<p>שתי קבוצות מדיטציה פעילות — בתל אביב ובמושב טל שחר.</p>
	<h2>ספריית הקלטות מודרכות</h2>
	<p>
		ספריית ההקלטות המודרכות מיועדת לחברי הקבוצות ומוגנת בסיסמה — פנו לעודד אם אתם משתתפים ואין
		לכם סיסמה.
	</p>
	<p class="cta">
		<PillButton href={withBase('/meditationlibrary')} variant="outline">לספריית ההקלטות</PillButton>
	</p>
</ProsePage>

<style>
	.cta {
		margin-top: var(--space-3);
	}
</style>
