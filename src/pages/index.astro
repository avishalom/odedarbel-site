---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureTriad from '../components/FeatureTriad.astro';
import PillButton from '../components/PillButton.astro';
import { withBase } from '../i18n';
---

<BaseLayout
	locale="he"
	currentPath="/"
	title="דף הבית"
	description="ד&quot;ר עודד ארבל — פסיכיאטר מומחה, פסיכותרפיה אינטגרטיבית, מיינדפולנס ופסיכותרפיה פסיכדלית."
>
	<Hero
		title='ד"ר עודד ארבל'
		quote="To be in harmony with the oneness of all things is to be without anxiety about imperfections"
		quoteAttribution="Dōgen Zenji (1200–1253, Japan)"
		imageAlt="נוף מדברי של דיונות חול והרים, מייצג את המרחב הטבעי בו מתקיימת העבודה הטיפולית"
	/>

	<section>
		<div class="container bio">
			<p>
				פסיכיאטר מומחה, בוגר ביה"ס לרפואה באונ' ת"א והתכנית לפסיכותרפיה פסיכואנליטית באוניברסיטת
				ת"א.
			</p>
			<p>עוסק בפסיכותרפיה וייעוץ גם במסגרת פרטית בקליניקה בת"א ובטל שחר.</p>
			<p>
				מנחה קבוצות מדיטציה למטופלים ולצוות, עוסק בטיפול פרטני במגוון הפרעות ובהוראה והכשרה של
				מטפלים בתורת הנפש הבודהיסטית וגישות מבוססות מיינדפולנס.
			</p>
			<p>
				בשנת הלימודים הקרובה תיפתח בנוסף גם התכנית לפסיכותרפיה פסיכדלית. לפרטים:
				<a href="https://www.psychedelictherapy.co.il">psychedelictherapy.co.il</a>
			</p>
			<details>
				<summary>קרא עוד</summary>
				<p>
					פסיכיאטר מומחה, בוגר ביה"ס לרפואה באונ' ת"א והתכנית לפסיכותרפיה פסיכואנליטית באוניברסיטת
					ת"א, התמחות בפסיכיאטריה במרכז לבריאות הנפש "שלוותה" הוד השרון.
				</p>
				<p>
					מנהל היחידה לטיפול יום "גבים" במרכז לבריאות הנפש באר שבע, העוסקת בטיפול בחרדה, דכאון,
					ובעיקר בנפגעי ונפגעות טראומה מורכבת, מינית ואחרת. מייסד ועומד בראש מרפאת המיינדפולנס
					שבמרכז לבריאות הנפש בבאר שבע והתכנית להכשרת מטפלים פסיכותרפיה מבוססת חוויה באוריינטציה
					זן בודהיסטית. ראש היחידה לטיפול ומחקר פסיכדלי בביה"ח, ומייסד שותף של התכנית לפסיכותרפיה
					פסיכדלית.
				</p>
				<p>
					עוסק בייעוץ פסיכיאטרי ובפסיכותרפיה באוריינטציה דינאמית, פסיכואנליטית לצד פסיכותרפיה
					מבוססת חוויה ומעוגנת בגוף בקליניקה בטל שחר.
				</p>
				<p>
					בוגר תכנית המטפלים של פסיכודהרמה – מרכז, שהוקם בשנת 1998 ע"י פרופ' יעקב רז ונחי אלון,
					המפגיש מטפלים ואנשים ממקצועות שונים עם הבודהיזם בדרך ייחודית המשלבת עיון, התנסות ואימון
					וכיום חבר בסגל ההוראה של בית הספר. מטפל מוסמך בשיאצו. בעל חגורה שחורה בקארטה, מדריך
					צלילה ומנסה לנגן בחליל במבוק.
				</p>
				<p>
					תלמידו של פרופ' רז, ומתאמן ומלמד בדרך הזן בודהיזם. בעל ניסיון רב בהנחיית קבוצות מדיטציה
					וקבוצות טיפוליות בגישות מבוססות מיינדפולנס וקבוצות באוריינטציה דינאמית.
				</p>
			</details>
			<details>
				<summary>בנימה אישית</summary>
				<p>
					מתרגל מדיטציה מאז 1997. חי במושב טל שחר, מגדל 450 עצים יחד עם שני בניו. עבודתו משלבת
					עקרונות בודהיסטיים עם פסיכותרפיה דינאמית, גישות מבוססות גוף וחוויה, ומחקר פסיכדלי, מתוך
					מטרה להקל על מצוקה נפשית.
				</p>
			</details>
			<details>
				<summary>פירסומים</summary>
				<ul>
					<li>
						Arluk, Matar, Carmi, Arbel, Zohar, Todder & Cohen (2022) — "MDMA treatment paired with a
						trauma-cue promotes adaptive stress responses in a translational model of PTSD in rats",
						<em>Translational Psychiatry</em>, 12, doi:10.1038/s41398-022-01952-8
					</li>
					<li>
						Cohen, Gotlieb, Erez, Wiznitzer, Arbel, Matas, Koren & Henik (2022) — "Attentional
						Networks during the Menstrual Cycle", <em>Behavioral Brain Research</em>, 425, 113817,
						doi:10.1016/j.bbr.2022.113817
					</li>
					<li>
						Cohen, Gotlieb, Erez, Wiznitzer, Arbel, Matas, Koren & Henik (2019) — "Attentional
						Networks during the Menstrual Cycle", doi:10.1101/717264
					</li>
					<li>
						Cohen, Reiner, Shmulevich & Arbel (2016) — "Seeds of Mindfulness in the Desert:
						Preliminary Results from a Clinical Trial in the Mindfulness Clinic Mental Health
						Center, Beer Sheva", <em>Harefuah</em>, 155, 745–748
					</li>
					<li>
						Arbel (2014) — "Sowing the Seeds of Mindfulness: Experiences from the Israeli Desert
						Mindfulness Clinic", <em>Mindfulness</em>, 5, doi:10.1007/s12671-013-0255-1
					</li>
					<li>
						Arbel (2012) — "Mindfulness in a Psychiatric Hospital", <em
							>The Israel Journal of Psychiatry and Related Sciences</em
						>, 49, 16
					</li>
					<li>
						Arbel, Shalev & Kaplan (2011) — "Implementing Mindfulness-Based Therapies as Part of the
						Comprehensive Treatments in Beer Sheba Mental Health Center", <em>Harefuah</em>, 150,
						676–80, 686, 685
					</li>
				</ul>
			</details>
			<details>
				<summary>וידאו / אודיו</summary>
				<div class="video-grid">
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/ceIX9lh-c2A"
							title='ד"ר ארבל: מדיטציה בודהיסטית - למה ואיך'
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/L2hQel4lJHs"
							title='בריאות 2 עם ד"ר ולפיש: מיינדפולנס'
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/MxUhgrJxGHA"
							title='ד"ר עודד ארבל — ראיון עם אלון סיגו'
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/lOICF6JJ7gE"
							title='שיחה בין יעקב רז וד"ר עודד ארבל'
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
				</div>
				<p><strong>פודקאסטים</strong></p>
				<ul>
					<li>RAW: One Year On - Healing the Trauma of Oct 7</li>
					<li>
						להתעורר - מבוא לבודהיזם ופילוסופיה של המזרח: שיחה על מדיטציה, טיפול פסיכיאטרי, ומשני
						תודעה
					</li>
					<li>מחוץ לקופסא - שעה על פסיכולוגיה: פסיכותרפיה פסיכדלית</li>
					<li>תחושת בטן: על אמונה, משני תודעה ומדיטציה</li>
				</ul>
			</details>
		</div>
	</section>

	<section class="cream">
		<div class="container">
			<FeatureTriad
				items={[
					{
						icon: 'plant',
						title: 'פסיכיאטריה אינטגרטיבית',
						text: 'גוף ידע ופרקטיקה קלינית המתבססת על רפואה מערבית, פסיכותרפיה פסיכודינאמית ופילוסופיה בודהיסטית.',
					},
					{
						icon: 'hands',
						title: 'מיינדפולנס וגוף',
						text: 'נוכחות משמעותית למרכיב הגופני בחוויה, חמלה וקשב רצוף לרגע הזה.',
					},
					{
						icon: 'mushroom',
						title: 'פסיכותרפיה פסיכדלית',
						text: 'ראש היחידה לטיפול ומחקר פסיכדלי, ומייסד שותף של התכנית לפסיכותרפיה פסיכדלית.',
					},
				]}
			/>
			<p class="triad-cta">
				<PillButton href={withBase("/psychadelicresearchandtherapy")} variant="outline">קראו עוד</PillButton>
			</p>
		</div>
	</section>

	<section>
		<div class="container">
			<h2>יצירת קשר</h2>
			<p>עודד: 050-6576691</p>
			<p>מייל: <a href="mailto:oded.arbel@gmail.com">oded.arbel@gmail.com</a></p>
			<p>קליניקה: מושב טל שחר</p>
			<PillButton href={withBase("/contact")}>צרו קשר</PillButton>
		</div>
	</section>
</BaseLayout>

<style>
	.bio {
		max-width: 42rem;
	}
	details {
		margin-block: var(--space-2);
		border-top: 1px solid rgba(26, 43, 60, 0.12);
		padding-top: var(--space-2);
	}
	summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--color-navy);
	}
	.triad-cta {
		text-align: center;
		margin-top: var(--space-4);
	}
	.video-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-2);
		margin-block: var(--space-2);
	}
	.video-embed {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--color-navy);
	}
	.video-embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
