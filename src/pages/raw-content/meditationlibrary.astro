---
import { getEntry, render } from 'astro:content';
import MeditationPlayer from '../../components/MeditationPlayer.astro';
import ProsePage from '../../components/ProsePage.astro';
import { withBase } from '../../i18n';
import { meditationLibraryHref, meditationLibraryTracks } from '../../meditationLibrary';

const entry = await getEntry('gated', 'he/meditation-library');
if (!entry) throw new Error('meditation-library.he entry not found');
const { Content } = await render(entry);
---

<ProsePage locale="he" currentPath="/meditationlibrary" title={entry.data.title} description={entry.data.description}>
	<Content />
	<div class="recording-list">
		{meditationLibraryTracks.map((track) => (
			<MeditationPlayer
				title={track.he.title}
				category={track.he.category}
				description={track.he.description}
				duration={track.duration}
				src={withBase(meditationLibraryHref(track.filename))}
				downloadLabel="הורדה"
				playLabel={`נגן את ${track.he.title}`}
				pauseLabel={`השהה את ${track.he.title}`}
			/>
		))}
	</div>
</ProsePage>

<style>
	.recording-list {
		display: grid;
		gap: 1.5rem;
		margin-block-start: 2rem;
	}
</style>
