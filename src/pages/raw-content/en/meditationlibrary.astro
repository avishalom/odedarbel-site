---
import { getEntry, render } from 'astro:content';
import MeditationPlayer from '../../../components/MeditationPlayer.astro';
import ProsePage from '../../../components/ProsePage.astro';
import { withBase } from '../../../i18n';
import { meditationLibraryHref, meditationLibraryTracks } from '../../../meditationLibrary';

const entry = await getEntry('gated', 'en/meditation-library');
if (!entry) throw new Error('meditation-library.en entry not found');
const { Content } = await render(entry);
---

<ProsePage locale="en" currentPath="/en/meditationlibrary" title={entry.data.title} description={entry.data.description}>
	<Content />
	<div class="recording-list">
		{meditationLibraryTracks.map((track) => (
			<MeditationPlayer
				title={track.en.title}
				category={track.en.category}
				description={track.en.description}
				duration={track.duration}
				src={withBase(meditationLibraryHref(track.filename))}
				downloadLabel="Download"
				playLabel={`Play ${track.en.title}`}
				pauseLabel={`Pause ${track.en.title}`}
			/>
		))}
	</div>
</ProsePage>

<style>
	.recording-list {
		display: grid;
		gap: 1.5rem;
		margin-block-start: 2rem;
	}
</style>
