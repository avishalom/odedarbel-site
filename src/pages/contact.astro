---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo';
const seo = pageSeo.he['/contact'];
---

<BaseLayout locale="he" currentPath="/contact" title={seo.title} description={seo.description}>
	<section>
		<div class="container prose">
			<h1>צרו קשר</h1>
			<p>עודד: 050-6576691</p>
			<p>מייל: <a href="mailto:oded.arbel@gmail.com">oded.arbel@gmail.com</a></p>
			<p>קליניקה: מושב טל שחר</p>

			<form>
				<div class="field">
					<label for="first-name">שם פרטי<span aria-hidden="true">*</span></label>
					<input type="text" id="first-name" name="first-name" required autocomplete="given-name" />
				</div>
				<div class="field">
					<label for="last-name">שם משפחה<span aria-hidden="true">*</span></label>
					<input type="text" id="last-name" name="last-name" required autocomplete="family-name" />
				</div>
				<div class="field">
					<label for="email">אימייל<span aria-hidden="true">*</span></label>
					<input type="email" id="email" name="email" required autocomplete="email" />
				</div>
				<div class="field">
					<label for="phone">טלפון<span aria-hidden="true">*</span></label>
					<input type="tel" id="phone" name="phone" required autocomplete="tel" />
				</div>
				<div class="field">
					<label for="message">הודעה</label>
					<textarea id="message" name="message" rows="5"></textarea>
				</div>
				<button type="submit">שלח</button>
			</form>
			<p class="note">
				<em>הערה: הטופס עדיין אינו מחובר לשירות שליחה בפועל — יש לחבר לפני פרסום (למשל Formspree
				או שירות דומה).</em>
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.prose {
		max-width: 32rem;
	}
	form {
		margin-top: var(--space-4);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	label {
		font-weight: 600;
		color: var(--color-teal-dark);
	}
	input,
	textarea {
		font: inherit;
		padding: 0.65rem 0.85rem;
		border: 1px solid rgba(92, 58, 24, 0.3);
		border-radius: 0.5rem;
		background: var(--color-white);
	}
	button[type='submit'] {
		align-self: flex-start;
		margin-top: var(--space-1);
		padding: 0.85rem 2rem;
		border-radius: var(--radius-pill);
		border: 2px solid var(--color-teal);
		background: var(--color-teal);
		color: var(--color-white);
		font-weight: 600;
		cursor: pointer;
	}
	button[type='submit']:hover {
		background: var(--color-teal-dark);
		border-color: var(--color-teal-dark);
	}
	.note {
		margin-top: var(--space-3);
	}
</style>
