---
import ProsePage from '../components/ProsePage.astro';
import PillButton from '../components/PillButton.astro';
import { withBase } from '../i18n';
import { pageSeo } from '../seo';
const seo = pageSeo.he['/therapists-program'];
---

<ProsePage locale="he" currentPath="/therapists-program" title={seo.title} description={seo.description}>
	<p>
		תכנית הכשרת מטפלים תלת-שנתית של מרכז המדבר למיינדפולנס, הפועלת מאז 2011. התכנית משלבת
		פסיכותרפיה חווייתית בהשראה בודהיסטית עם לימוד תיאורטי, יישום מעשי והכשרה קלינית בגישות
		מבוססות מיינדפולנס.
	</p>
	<h2>מבנה התכנית</h2>
	<ul>
		<li>יום לימודים שבועי אחד (ימי רביעי) בתוספת תקופות ריטריט מרוכזות</li>
		<li>מיקום: קיבוץ חצרים, באולם נוח ומאוורר</li>
		<li>נדרשת נוכחות פיזית; השתתפות בזום אפשרית במקרים מיוחדים</li>
	</ul>
	<h2>פילוסופיית ההוראה</h2>
	<p>
		"הכלי הטיפולי המרכזי הוא הנוכחות הטיפולית" — ומתוכה צומחות הפרקטיקות הקליניות. ההכשרה כוללת
		מספר ריטריטים להעמקת הלמידה ופיתוח איכויות של קבלה, נוכחות וחמלה.
	</p>
	<h2>סגל</h2>
	<p>
		בראשות ד"ר עודד ארבל (פסיכיאטר ומנהל התכנית), לצד מורים בולטים בתחומי לימודי בודהיזם, פסיכולוגיה
		גופנית ותרגול מדיטציה מהקהילה האקדמית והטיפולית בישראל.
	</p>
	<h2>למי מיועדת התכנית</h2>
	<p>
		אנשי ונשות מקצועות בריאות הנפש — פסיכולוגים/יות, פסיכיאטרים/יות, עובדים/ות סוציאליים/ות,
		רופאים/ות ומטפלים/ות באמנויות — בעלי הכשרה פסיכודינמית קודמת. הקבלה מותנית בראיון אישי.
	</p>
	<h2>עלות שנתית</h2>
	<ul>
		<li>תכנית תלת-שנתית: 8,000 ש"ח לשנה</li>
		<li>תכנית המשך לבוגרים: 4,500 ש"ח לשנה</li>
	</ul>
	<h2>ספריית התכנית</h2>
	<p>חומרי הקריאה של התכנית זמינים למשתתפים בעמוד מוגן בסיסמה.</p>
	<p>
		<PillButton href={withBase('/therapistdoc')} variant="outline">לספריית תוכנית המטפלים</PillButton>
	</p>
	<h2>הרשמה</h2>
	<p>הרשמה מתבצעת דרך טופס מקוון; מספר המקומות מוגבל.</p>
</ProsePage>
