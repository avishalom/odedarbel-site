---
import ProsePage from '../../components/ProsePage.astro';
import { pageSeo } from '../../seo';
const seo = pageSeo.en['/en/tamar-amit'];
---

<ProsePage locale="en" currentPath="/en/tamar-amit" title={seo.title} description={seo.description}>
	<p>
		Senior partner in the teaching team of the Therapists Program. Clinical psychologist, graduate
		of Ben-Gurion and Reichman Universities, and graduate of the psychedelic psychotherapy program.
		Practices psychotherapy at clinics in Tel Aviv and Tal Shahar.
	</p>
	<p>
		Facilitates groups, retreats, and personal-development processes focused on psychological
		resilience. Integrates psychodynamic understanding with Buddhist and shamanic approaches,
		incorporating body awareness, breath, and voice work.
	</p>
	<p>
		Creates and holds safe spaces, participates in psychedelic research studies in Israel, and
		completed extended training with shamanic teachers in Mexico.
	</p>
	<p>Interested in accompanying processes of maturation and growth for individuals.</p>
	<p>Contact: <a href="mailto:tamarmoo@gmail.com">tamarmoo@gmail.com</a></p>
	<blockquote>
		<p>
			"There is a deep well within me. God dwells in that well. Sometimes I am able to reach Him.
			Often the well is covered with stones and sand, and God is buried beneath. Then He must be dug
			out again."
		</p>
		<cite>— Etty Hillesum</cite>
	</blockquote>
</ProsePage>

<style>
	blockquote {
		border-inline-start: 3px solid var(--color-teal);
		padding-inline-start: var(--space-2);
		font-style: italic;
	}
</style>
