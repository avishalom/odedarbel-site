---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { pageSeo } from '../../seo';
const seo = pageSeo.en['/en/meditationlibrary'];
---

<BaseLayout
	locale="en"
	currentPath="/en/meditationlibrary"
	title={seo.lockedTitle ?? seo.title}
	description={seo.lockedDescription ?? seo.description}
	noindex={seo.noindex}
>
	<PasswordGate locale="en" />
</BaseLayout>
