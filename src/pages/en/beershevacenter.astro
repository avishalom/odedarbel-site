---
import ProsePage from '../../components/ProsePage.astro';
import { pageSeo } from '../../seo';
const seo = pageSeo.en['/en/beershevacenter'];
---

<ProsePage locale="en" currentPath="/en/beershevacenter" title={seo.title} description={seo.description}>
	<p>
		Mindfulness-based treatments are increasingly popular for a wide range of psychological and
		physical conditions.
	</p>
	<h2>Services</h2>
	<ul>
		<li>Mindfulness learning and practice groups</li>
		<li>Continuation groups</li>
		<li>Staff training on the therapeutic potential of mindfulness</li>
		<li>Burnout prevention and treatment</li>
		<li>Individual and group sessions</li>
	</ul>
	<h2>Treatment areas</h2>
	<p>
		Chronic pain, stress and anxiety, depression and relapse prevention, PTSD and
		obsessive-compulsive disorders, personality and eating disorders, ADHD, psychotic conditions,
		and addictions.
	</p>
	<h2>Course structure</h2>
	<p>
		8–10 sessions (1.5–2 hours each), combining theoretical background, guided meditation, and
		discussion of experience. Requires a commitment to independent practice at home.
	</p>
	<h2>Contact</h2>
	<ul>
		<li>Phone: 08-6401606</li>
		<li>Email: <a href="mailto:mindfulness@pbsh.health.gov.il">mindfulness@pbsh.health.gov.il</a></li>
		<li>Address: HaTzadik MiYerushalayim 2, Beer Sheva</li>
		<li>Subsidized participation available based on financial need</li>
	</ul>
</ProsePage>
