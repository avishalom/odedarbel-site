---
import ProsePage from '../../components/ProsePage.astro';
import { pageSeo } from '../../seo';
const seo = pageSeo.en['/en/psychadelicresearchandtherapy'];
---

<ProsePage locale="en" currentPath="/en/psychadelicresearchandtherapy" title={seo.title} description={seo.description}>
	<p>
		Head of the Psychedelic Treatment and Research Unit at Beer Sheva Mental Health Center, and
		co-founder of the psychedelic psychotherapy program.
	</p>
	<p>
		For more on the psychedelic psychotherapy training program:
		<a href="https://www.psychedelictherapy.co.il">psychedelictherapy.co.il</a>
	</p>
	<p class="note">
		<em
			>Note: the original page contained mostly a background image and navigation, with no detailed
			content. A full description of the services and active research should be confirmed with Dr.
			Arbel before final publication.</em
		>
	</p>
</ProsePage>

<style>
	.note {
		border-top: 1px solid rgba(92, 58, 24, 0.18);
		padding-top: var(--space-2);
		margin-top: var(--space-3);
	}
</style>
