---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FeatureTriad from '../../components/FeatureTriad.astro';
import PillButton from '../../components/PillButton.astro';
import { withBase } from '../../i18n';
import { pageSeo } from '../../seo';
const seo = pageSeo.en['/en/'];
---

<BaseLayout locale="en" currentPath="/en/" title={seo.title} description={seo.description}>
	<Hero
		title="Dr. Oded Arbel"
		quote="To be in harmony with the oneness of all things is to be without anxiety about imperfections"
		quoteAttribution="Dōgen Zenji (1200–1253, Japan)"
		imageAlt="A desert landscape of dunes and mountains, evoking the natural setting of the clinical work"
	/>

	<section>
		<div class="container bio-shell">
			<figure class="bio-portrait">
				<img src={withBase('/images/oded-arbel-portrait.jpg')} alt="Dr. Oded Arbel" loading="lazy" />
			</figure>
			<div class="bio">
				<p>
					Specialist psychiatrist, graduate of the Tel Aviv University School of Medicine and its
					Psychoanalytic Psychotherapy program.
				</p>
				<p>Sees patients privately for psychotherapy and consultation at clinics in Tel Aviv and Tal Shahar.</p>
				<p>
					Facilitates meditation groups for patients and staff, works individually across a range of
					disorders, and teaches and trains therapists in Buddhist psychology and mindfulness-based
					approaches.
				</p>
				<p>
					A psychedelic psychotherapy training program launches in the coming academic year. Details:
					<a href="https://www.psychedelictherapy.co.il">psychedelictherapy.co.il</a>
				</p>
				<details>
				<summary>Read more</summary>
				<p>
					Specialist psychiatrist, graduate of the Tel Aviv University School of Medicine and its
					Psychoanalytic Psychotherapy program, with residency in psychiatry at the "Shalvata"
					Mental Health Center in Hod Hasharon.
				</p>
				<p>
					Director of the "Gvim" day-treatment unit at Beer Sheva Mental Health Center, treating
					anxiety, depression, and — primarily — survivors of complex sexual and other trauma.
					Founder and head of the mindfulness clinic at Beer Sheva Mental Health Center and of its
					Zen Buddhist-oriented experiential psychotherapy training program. Head of the hospital's
					Psychedelic Treatment and Research Unit, and co-founder of the psychedelic psychotherapy
					program.
				</p>
				<p>
					Provides psychiatric consultation and psychotherapy in a dynamic, psychoanalytic
					orientation alongside body-based experiential psychotherapy at the Tal Shahar clinic.
				</p>
				<p>
					Graduate of the Psychodharma therapists' program — founded in 1998 by Prof. Jacob Raz and
					Nahi Alon — which brings therapists and professionals from various fields into contact
					with Buddhism through study, experience, and practice; now a member of the school's
					teaching faculty. Certified Shiatsu practitioner. Black belt in Karate, scuba diving
					instructor, and an aspiring bamboo-flute player.
				</p>
				<p>
					A student of Prof. Raz, practicing and teaching in the Zen Buddhist tradition. Extensive
					experience facilitating meditation groups and therapy groups in mindfulness-based and
					dynamic orientations.
				</p>
				</details>
				<details>
				<summary>A personal note</summary>
				<p>
					In one of my earliest childhood memories, I am dozing at the edge of the meditation hall
					where my mother practiced. Around 1997, I took on a regular practice of meditation and
					theoretical study. My main interest in dharma and therapy is finding ways to ease mental
					distress, through an integration of Buddhist principles and classical dynamic psychotherapy,
					an integrative view of body and spirit, the study of consciousness with psychedelic
					substances in clinical research and therapy, skillful use of means, and above all —
					attention.
				</p>
				<p>
					I live in Tal Shahar, grow 450 trees, and have two sons. Every day, I am grateful for the
					opportunity to be a student.
				</p>
				</details>
				<details>
				<summary>Publications</summary>
				<ul>
					<li>
						Arluk, Matar, Carmi, Arbel, Zohar, Todder & Cohen (2022) — "MDMA treatment paired with a
						trauma-cue promotes adaptive stress responses in a translational model of PTSD in rats",
						<em>Translational Psychiatry</em>, 12, doi:10.1038/s41398-022-01952-8
					</li>
					<li>
						Cohen, Gotlieb, Erez, Wiznitzer, Arbel, Matas, Koren & Henik (2022) — "Attentional
						Networks during the Menstrual Cycle", <em>Behavioral Brain Research</em>, 425, 113817,
						doi:10.1016/j.bbr.2022.113817
					</li>
					<li>
						Cohen, Gotlieb, Erez, Wiznitzer, Arbel, Matas, Koren & Henik (2019) — "Attentional
						Networks during the Menstrual Cycle", doi:10.1101/717264
					</li>
					<li>
						Cohen, Reiner, Shmulevich & Arbel (2016) — "Seeds of Mindfulness in the Desert:
						Preliminary Results from a Clinical Trial in the Mindfulness Clinic Mental Health
						Center, Beer Sheva", <em>Harefuah</em>, 155, 745–748
					</li>
					<li>
						Arbel (2014) — "Sowing the Seeds of Mindfulness: Experiences from the Israeli Desert
						Mindfulness Clinic", <em>Mindfulness</em>, 5, doi:10.1007/s12671-013-0255-1
					</li>
					<li>
						Arbel (2012) — "Mindfulness in a Psychiatric Hospital", <em
							>The Israel Journal of Psychiatry and Related Sciences</em
						>, 49, 16
					</li>
					<li>
						Arbel, Shalev & Kaplan (2011) — "Implementing Mindfulness-Based Therapies as Part of the
						Comprehensive Treatments in Beer Sheba Mental Health Center", <em>Harefuah</em>, 150,
						676–80, 686, 685
					</li>
				</ul>
				</details>
				<details>
				<summary>Video / Audio</summary>
				<div class="video-grid">
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/ceIX9lh-c2A"
							title="Dr. Arbel: Buddhist Meditation - Why and How"
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/L2hQel4lJHs"
							title="Health 2 with Dr. Valfish: Mindfulness"
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/MxUhgrJxGHA"
							title="Dr. Oded Arbel — interview with Alon Sigo"
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
					<div class="video-embed">
						<iframe
							src="https://www.youtube-nocookie.com/embed/lOICF6JJ7gE"
							title="A conversation between Jacob Raz and Dr. Oded Arbel"
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
				</div>
				<p><strong>Podcasts</strong></p>
				<ul>
					<li>
						<a href="https://open.spotify.com/episode/0dKUcqkGKTWJSRwKlsytkc"
							>RAW: One Year On - Healing the Trauma of Oct 7</a
						>
					</li>
					<li>
						<a href="https://open.spotify.com/episode/4uSJ5mzAUtR4CSbV9DYYNR"
							>L'hitorer (Awakening) - Introduction to Buddhism and Eastern Philosophy: a conversation
							on meditation, psychiatric treatment, and psychedelics</a
						>
					</li>
					<li>
						<a href="https://open.spotify.com/episode/748zryW96NJeKv9T4zQQl5"
							>Michutz LaKufsa (Outside the Box) - An Hour on Psychology: Psychedelic Psychotherapy</a
						>
					</li>
					<li>
						<a href="https://open.spotify.com/episode/6YhMnDTKdWkcfi7TIatelB"
							>Tchushat Beten (Gut Feeling): on faith, psychedelics, and meditation</a
						>
					</li>
				</ul>
				</details>
			</div>
		</div>
	</section>

	<section class="cream">
		<div class="container">
			<FeatureTriad
				items={[
					{
						icon: 'plant',
						title: 'Integrative Psychiatry',
						text: 'A body of knowledge and clinical practice grounded in Western medicine, psychodynamic psychotherapy, and Buddhist philosophy.',
					},
					{
						icon: 'hands',
						title: 'Mindfulness & the Body',
						text: 'Meaningful presence to the bodily dimension of experience, compassion, and sustained attention to the present moment.',
					},
					{
						icon: 'mushroom',
						title: 'Psychedelic Psychotherapy',
						text: "Head of the Psychedelic Treatment and Research Unit, and co-founder of the psychedelic psychotherapy program.",
					},
				]}
			/>
			<p class="triad-cta">
				<PillButton href={withBase("/en/psychadelicresearchandtherapy")} variant="outline">Read more</PillButton>
			</p>
		</div>
	</section>

	<section>
		<div class="container">
			<h2>Get in touch</h2>
			<p>Phone: 050-6576691</p>
			<p>Email: <a href="mailto:oded.arbel@gmail.com">oded.arbel@gmail.com</a></p>
			<p>Clinic: Moshav Tal Shahar</p>
			<PillButton href={withBase("/en/contact")}>Contact</PillButton>
		</div>
	</section>
</BaseLayout>

<style>
	.bio {
		max-width: 42rem;
	}
	.bio-shell {
		display: grid;
		grid-template-columns: minmax(12rem, 18rem) minmax(0, 42rem);
		align-items: start;
		gap: var(--space-4);
	}
	.bio-portrait {
		margin: 0;
	}
	.bio-portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 0.5rem;
		filter: sepia(0.08);
	}
	details {
		margin-block: var(--space-2);
		border-top: 1px solid rgba(92, 58, 24, 0.18);
		padding-top: var(--space-2);
	}
	summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--color-teal-dark);
	}
	.triad-cta {
		text-align: center;
		margin-top: var(--space-4);
	}
	.video-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-2);
		margin-block: var(--space-2);
	}
	.video-embed {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--color-navy);
	}
	.video-embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	@media (max-width: 760px) {
		.bio-shell {
			grid-template-columns: 1fr;
		}
		.bio-portrait {
			max-width: 14rem;
		}
	}
</style>
