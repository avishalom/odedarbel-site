---
import ProsePage from '../components/ProsePage.astro';
import { pageSeo } from '../seo';
const seo = pageSeo.he['/psychadelicresearchandtherapy'];
---

<ProsePage locale="he" currentPath="/psychadelicresearchandtherapy" title={seo.title} description={seo.description}>
	<p>
		ראש היחידה לטיפול ומחקר פסיכדלי במרכז לבריאות הנפש באר שבע, ומייסד שותף של התכנית לפסיכותרפיה
		פסיכדלית.
	</p>
	<p>
		לפרטים נוספים על התכנית לפסיכותרפיה פסיכדלית:
		<a href="https://www.psychedelictherapy.co.il">psychedelictherapy.co.il</a>
	</p>
	<p class="note">
		<em
			>הערה: העמוד המקורי כלל בעיקר תמונת רקע וניווט, ללא תוכן מפורט. יש להשלים תיאור מלא של
			השירותים והמחקר הפעיל מול ד"ר ארבל לפני פרסום סופי.</em
		>
	</p>
</ProsePage>

<style>
	.note {
		border-top: 1px solid rgba(92, 58, 24, 0.18);
		padding-top: var(--space-2);
		margin-top: var(--space-3);
	}
</style>
