---
import type { Locale } from '../i18n';
import { nav, altLangHref, uiStrings, withBase } from '../i18n';

interface Props {
	locale: Locale;
	currentPath: string;
}
const { locale, currentPath } = Astro.props;
const items = nav[locale];
const t = uiStrings[locale];
const altHref = locale === 'he' ? currentPath.replace(/^\/?/, '/en/') : currentPath.replace(/^\/en\/?/, '/');
---

<header class="site-header">
	<div class="container nav-inner">
		<a class="brand" href={withBase(locale === 'he' ? '/' : '/en/')}>{t.siteName}</a>
		<nav aria-label={locale === 'he' ? 'ניווט ראשי' : 'Main navigation'}>
			<ul>
				{items.map((item) => (
					<li>
						<a href={withBase(item.href)} aria-current={currentPath === item.href ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<a class="lang-switch" href={withBase(altHref)} hreflang={altLangHref[locale]}>
			{t.switchLang}
		</a>
	</div>
</header>

<style>
	.site-header {
		background: var(--color-cream-soft);
		border-bottom: 1px solid rgba(26, 43, 60, 0.08);
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding-block: var(--space-2);
	}
	.brand {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.4rem;
		color: var(--color-navy);
		text-decoration: none;
	}
	:lang(he) .brand {
		font-family: var(--font-display-he);
	}
	nav ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
	}
	nav a {
		color: var(--color-navy);
		text-decoration: none;
		font-weight: 500;
	}
	nav a:hover {
		color: var(--color-teal-dark);
		text-decoration: underline;
	}
	nav a[aria-current='page'] {
		color: var(--color-teal-dark);
		text-decoration: underline;
	}
	.lang-switch {
		border: 1px solid var(--color-teal);
		border-radius: var(--radius-pill);
		padding: 0.35rem 1rem;
		text-decoration: none;
		color: var(--color-teal-dark);
		font-size: 0.9rem;
		white-space: nowrap;
	}
	.lang-switch:hover {
		background: var(--color-teal);
		color: var(--color-white);
	}
</style>
