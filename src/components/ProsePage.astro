---
import type { Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	locale: Locale;
	currentPath: string;
	title: string;
	description: string;
	noindex?: boolean;
	proseWidth?: 'narrow' | 'default';
}
const { locale, currentPath, title, description, noindex, proseWidth = 'default' } = Astro.props;
---

<BaseLayout locale={locale} currentPath={currentPath} title={title} description={description} noindex={noindex}>
	<section>
		<div class={`container prose prose--${proseWidth}`}>
			<h1>{title}</h1>
			<slot />
		</div>
	</section>
</BaseLayout>

<style>
	.prose :global(h2) {
		margin-top: var(--space-4);
	}
	.prose {
		max-width: 42rem;
	}
	.prose--narrow {
		max-width: 32rem;
	}
</style>
