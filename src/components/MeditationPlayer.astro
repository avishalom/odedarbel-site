---
interface Props {
	title: string;
	category: string;
	description: string;
	duration: string;
	src: string;
	downloadLabel: string;
	playLabel: string;
	pauseLabel: string;
}

const { title, category, description, duration, src, downloadLabel, playLabel, pauseLabel } = Astro.props;
---

<meditation-player class="recording" data-play-label={playLabel} data-pause-label={pauseLabel}>
	<div class="recording__heading">
		<div>
			<p class="recording__category">{category}</p>
			<h2>{title} <span>{duration}</span></h2>
		</div>
		<p>{description}</p>
	</div>
	<audio preload="metadata" src={src}></audio>
	<div class="player" role="group" aria-label={title}>
		<button class="player__toggle" type="button" aria-label={playLabel}>
			<svg class="player__icon player__icon--play" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8 5v14l11-7z"></path>
			</svg>
			<svg class="player__icon player__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M7 5h4v14H7zM13 5h4v14h-4z"></path>
			</svg>
		</button>
		<span class="player__time player__time--current">0:00</span>
		<input class="player__seek" type="range" min="0" max="1000" value="0" step="1" aria-label={title} />
		<span class="player__time player__time--duration">{duration}</span>
		<a class="player__download" href={src} download>{downloadLabel}</a>
	</div>
</meditation-player>

<script>
	function formatTime(seconds: number): string {
		if (!Number.isFinite(seconds)) return '0:00';
		const total = Math.max(0, Math.floor(seconds));
		const minutes = Math.floor(total / 60);
		const remainder = total % 60;
		return `${minutes}:${String(remainder).padStart(2, '0')}`;
	}

	class MeditationPlayerElement extends HTMLElement {
		connectedCallback() {
			const audio = this.querySelector('audio');
			const toggle = this.querySelector<HTMLButtonElement>('.player__toggle');
			const seek = this.querySelector<HTMLInputElement>('.player__seek');
			const current = this.querySelector<HTMLElement>('.player__time--current');
			const duration = this.querySelector<HTMLElement>('.player__time--duration');
			if (!audio || !toggle || !seek || !current || !duration) return;

			const playLabel = this.dataset.playLabel ?? 'Play';
			const pauseLabel = this.dataset.pauseLabel ?? 'Pause';

			const updateButton = () => {
				this.classList.toggle('is-playing', !audio.paused);
				toggle.setAttribute('aria-label', audio.paused ? playLabel : pauseLabel);
			};

			const updateProgress = () => {
				current.textContent = formatTime(audio.currentTime);
				if (Number.isFinite(audio.duration) && audio.duration > 0) {
					seek.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
				}
			};

			toggle.addEventListener('click', async () => {
				if (audio.paused) {
					for (const other of document.querySelectorAll<HTMLAudioElement>('meditation-player audio')) {
						if (other !== audio) other.pause();
					}
					try {
						await audio.play();
					} catch {
						updateButton();
					}
				} else {
					audio.pause();
				}
			});

			seek.addEventListener('input', () => {
				if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
				audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
			});

			audio.addEventListener('loadedmetadata', () => {
				duration.textContent = formatTime(audio.duration);
				updateProgress();
			});
			audio.addEventListener('timeupdate', updateProgress);
			audio.addEventListener('play', updateButton);
			audio.addEventListener('pause', updateButton);
			audio.addEventListener('ended', () => {
				seek.value = '0';
				updateButton();
			});

			updateButton();
			updateProgress();
		}
	}

	if (!customElements.get('meditation-player')) {
		customElements.define('meditation-player', MeditationPlayerElement);
	}
</script>

<style>
	.recording {
		background: linear-gradient(180deg, var(--color-cream-soft), var(--color-cream));
		border: 1px solid rgba(92, 58, 24, 0.16);
		border-radius: 0.75rem;
		box-shadow: 0 0.75rem 2rem rgba(26, 43, 60, 0.07);
		display: block;
		padding: clamp(1rem, 3vw, 1.35rem);
	}

	.recording__heading {
		display: grid;
		gap: 0.35rem;
	}

	.recording__category {
		color: var(--color-teal-dark);
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0;
		margin: 0 0 0.25rem;
	}

	.recording h2 {
		align-items: baseline;
		color: var(--color-teal);
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 0.35rem;
	}

	.recording h2 span {
		color: var(--color-brown);
		font-family: var(--font-body);
		font-size: 0.96rem;
		font-weight: 500;
	}

	:global(:lang(he)) .recording h2 span {
		font-family: var(--font-body-he);
	}

	.recording p {
		margin-block-end: 0;
	}

	.player {
		align-items: center;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(28, 125, 142, 0.18);
		border-radius: 0.65rem;
		display: grid;
		gap: 0.85rem;
		grid-template-columns: 3rem 3.4rem minmax(8rem, 1fr) 3.4rem auto;
		margin-block-start: var(--space-2);
		padding: 0.75rem;
	}

	.player__toggle {
		align-items: center;
		appearance: none;
		background: var(--color-teal);
		border: 2px solid var(--color-teal);
		border-radius: 50%;
		box-shadow: 0 0.35rem 0.9rem rgba(20, 92, 105, 0.22);
		color: var(--color-white);
		cursor: pointer;
		display: inline-flex;
		height: 3rem;
		justify-content: center;
		padding: 0;
		width: 3rem;
	}

	.player__toggle:hover {
		background: var(--color-teal-dark);
		border-color: var(--color-teal-dark);
	}

	.player__toggle:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 3px;
	}

	.player__icon {
		display: block;
		fill: currentColor;
		height: 1.15rem;
		width: 1.15rem;
	}

	:global(:lang(he)) .player__icon--play {
		transform: scaleX(-1);
	}

	.player__icon--pause,
	.recording.is-playing .player__icon--play {
		display: none;
	}

	.recording.is-playing .player__icon--pause {
		display: block;
	}

	.player__time {
		color: var(--color-brown);
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		min-inline-size: 3.4rem;
		text-align: center;
	}

	.player__seek {
		appearance: none;
		background: transparent;
		cursor: pointer;
		inline-size: 100%;
		min-inline-size: 8rem;
	}

	.player__seek::-webkit-slider-runnable-track {
		background: linear-gradient(90deg, var(--color-teal), var(--color-teal-dark));
		border-radius: var(--radius-pill);
		height: 0.35rem;
	}

	.player__seek::-moz-range-track {
		background: linear-gradient(90deg, var(--color-teal), var(--color-teal-dark));
		border-radius: var(--radius-pill);
		height: 0.35rem;
	}

	.player__seek::-webkit-slider-thumb {
		appearance: none;
		background: var(--color-white);
		border: 2px solid var(--color-teal-dark);
		border-radius: 50%;
		box-shadow: 0 0.2rem 0.45rem rgba(26, 43, 60, 0.18);
		height: 1rem;
		margin-top: -0.325rem;
		width: 1rem;
	}

	.player__seek::-moz-range-thumb {
		background: var(--color-white);
		border: 2px solid var(--color-teal-dark);
		border-radius: 50%;
		box-shadow: 0 0.2rem 0.45rem rgba(26, 43, 60, 0.18);
		height: 1rem;
		width: 1rem;
	}

	.player__download {
		border: 1px solid rgba(28, 125, 142, 0.42);
		border-radius: var(--radius-pill);
		color: var(--color-teal-dark);
		font-size: 0.88rem;
		font-weight: 700;
		padding: 0.35rem 0.85rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.player__download:hover {
		background: var(--color-teal);
		border-color: var(--color-teal);
		color: var(--color-white);
	}

	@media (max-width: 38rem) {
		.player {
			grid-template-columns: 3rem 1fr auto;
		}

		.player__time--current {
			text-align: start;
		}

		.player__seek {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.player__download {
			grid-column: 1 / -1;
			justify-self: start;
		}
	}
</style>
