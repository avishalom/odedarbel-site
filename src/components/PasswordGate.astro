---
import type { Locale } from '../i18n';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;

const strings = {
	he: {
		heading: 'אזור מוגן',
		hint: 'הכניסה באמצעות סיסמה בלבד',
		placeholder: 'סיסמה',
		submit: 'כניסה',
		wrong: 'הסיסמה לא נכונה, כדאי לנסות שוב.',
	},
	en: {
		heading: 'Protected area',
		hint: 'Enter the password to continue',
		placeholder: 'Password',
		submit: 'Enter',
		wrong: 'Incorrect password — please try again.',
	},
};
const t = strings[locale];
---

<section class="gate">
	<div class="container gate-inner">
		<h1>{t.heading}</h1>
		<p>{t.hint}</p>
		<form id="gate-form" autocomplete="off">
			<input type="password" id="gate-password" name="password" placeholder={t.placeholder} required autocomplete="off" />
			<button type="submit">{t.submit}</button>
		</form>
		<p id="gate-error" class="gate-error" hidden>{t.wrong}</p>
	</div>
</section>

<div id="gate-payload" data-iv="__GATE_IV__" data-cipher="__GATE_CIPHER__" hidden></div>

<script>
	function base64ToBytes(b64: string): Uint8Array {
		return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
	}

	async function deriveKey(password: string): Promise<CryptoKey> {
		const keyMaterial = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(password));
		return crypto.subtle.importKey('raw', keyMaterial, 'AES-GCM', false, ['decrypt']);
	}

	async function tryUnlock(password: string): Promise<string | null> {
		const payload = document.getElementById('gate-payload');
		if (!payload) return null;
		const iv = base64ToBytes(payload.dataset.iv!);
		const cipher = base64ToBytes(payload.dataset.cipher!);
		try {
			const key = await deriveKey(password);
			const plainBuf = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, cipher);
			return new TextDecoder().decode(plainBuf);
		} catch {
			return null;
		}
	}

	function formatTime(seconds: number): string {
		if (!Number.isFinite(seconds)) return '0:00';
		const total = Math.max(0, Math.floor(seconds));
		const minutes = Math.floor(total / 60);
		const remainder = total % 60;
		return `${minutes}:${String(remainder).padStart(2, '0')}`;
	}

	class MeditationPlayerElement extends HTMLElement {
		connectedCallback() {
			const audio = this.querySelector('audio');
			const toggle = this.querySelector<HTMLButtonElement>('.player__toggle');
			const seek = this.querySelector<HTMLInputElement>('.player__seek');
			const current = this.querySelector<HTMLElement>('.player__time--current');
			const duration = this.querySelector<HTMLElement>('.player__time--duration');
			if (!audio || !toggle || !seek || !current || !duration) return;

			const playLabel = this.dataset.playLabel ?? 'Play';
			const pauseLabel = this.dataset.pauseLabel ?? 'Pause';

			const updateButton = () => {
				this.classList.toggle('is-playing', !audio.paused);
				toggle.setAttribute('aria-label', audio.paused ? playLabel : pauseLabel);
			};

			const updateProgress = () => {
				current.textContent = formatTime(audio.currentTime);
				if (Number.isFinite(audio.duration) && audio.duration > 0) {
					seek.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
				}
			};

			toggle.addEventListener('click', async () => {
				if (audio.paused) {
					for (const other of document.querySelectorAll<HTMLAudioElement>('meditation-player audio')) {
						if (other !== audio) other.pause();
					}
					try {
						await audio.play();
					} catch {
						updateButton();
					}
				} else {
					audio.pause();
				}
			});

			seek.addEventListener('input', () => {
				if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
				audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
			});

			audio.addEventListener('loadedmetadata', () => {
				duration.textContent = formatTime(audio.duration);
				updateProgress();
			});
			audio.addEventListener('timeupdate', updateProgress);
			audio.addEventListener('play', updateButton);
			audio.addEventListener('pause', updateButton);
			audio.addEventListener('ended', () => {
				seek.value = '0';
				updateButton();
			});

			updateButton();
			updateProgress();
		}
	}

	if (!customElements.get('meditation-player')) {
		customElements.define('meditation-player', MeditationPlayerElement);
	}

	const form = document.getElementById('gate-form') as HTMLFormElement | null;
	const errorEl = document.getElementById('gate-error');
	const passwordInput = document.getElementById('gate-password') as HTMLInputElement | null;

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const password = passwordInput?.value.trim() ?? '';
		const html = await tryUnlock(password);
		if (html === null) {
			errorEl?.removeAttribute('hidden');
			return;
		}
		document.body.innerHTML = html;
	});
</script>

<style>
	.gate {
		min-height: 60vh;
		display: flex;
		align-items: center;
	}
	.gate-inner {
		max-width: 24rem;
	}
	.gate h1 {
		margin-bottom: var(--space-1);
	}
	form {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}
	input[type='password'] {
		font: inherit;
		padding: 0.65rem 0.85rem;
		border: 1px solid rgba(92, 58, 24, 0.3);
		border-radius: 0.5rem;
		background: var(--color-white);
	}
	button[type='submit'] {
		align-self: flex-start;
		padding: 0.85rem 2rem;
		border-radius: var(--radius-pill);
		border: 2px solid var(--color-teal);
		background: var(--color-teal);
		color: var(--color-white);
		font-weight: 600;
		cursor: pointer;
	}
	button[type='submit']:hover {
		background: var(--color-teal-dark);
		border-color: var(--color-teal-dark);
	}
	.gate-error {
		color: #a13c3c;
		margin-top: var(--space-2);
	}

	:global(.recording-list) {
		display: grid;
		gap: var(--space-3);
		margin-block-start: var(--space-4);
	}

	:global(.recording) {
		background: linear-gradient(180deg, var(--color-cream-soft), var(--color-cream));
		border: 1px solid rgba(92, 58, 24, 0.16);
		border-radius: 0.75rem;
		box-shadow: 0 0.75rem 2rem rgba(26, 43, 60, 0.07);
		display: block;
		padding: clamp(1rem, 3vw, 1.35rem);
	}

	:global(.recording__heading) {
		display: grid;
		gap: 0.35rem;
	}

	:global(.recording__category) {
		color: var(--color-teal-dark);
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0;
		margin: 0 0 0.25rem;
	}

	:global(.recording h2) {
		align-items: baseline;
		color: var(--color-teal);
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 0.35rem;
	}

	:global(.recording h2 span) {
		color: var(--color-brown);
		font-family: var(--font-body);
		font-size: 0.96rem;
		font-weight: 500;
	}

	:global(:lang(he) .recording h2 span) {
		font-family: var(--font-body-he);
	}

	:global(.recording p) {
		margin-block-end: 0;
	}

	:global(.player) {
		align-items: center;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(28, 125, 142, 0.18);
		border-radius: 0.65rem;
		display: grid;
		gap: 0.85rem;
		grid-template-columns: 3rem 3.4rem minmax(8rem, 1fr) 3.4rem auto;
		margin-block-start: var(--space-2);
		padding: 0.75rem;
	}

	:global(.player__toggle) {
		align-items: center;
		appearance: none;
		background: var(--color-teal);
		border: 2px solid var(--color-teal);
		border-radius: 50%;
		box-shadow: 0 0.35rem 0.9rem rgba(20, 92, 105, 0.22);
		color: var(--color-white);
		cursor: pointer;
		display: inline-flex;
		height: 3rem;
		justify-content: center;
		padding: 0;
		width: 3rem;
	}

	:global(.player__toggle:hover) {
		background: var(--color-teal-dark);
		border-color: var(--color-teal-dark);
	}

	:global(.player__toggle:focus-visible) {
		outline: 3px solid var(--color-focus);
		outline-offset: 3px;
	}

	:global(.player__icon) {
		display: block;
		fill: currentColor;
		height: 1.15rem;
		width: 1.15rem;
	}

	:global(:lang(he) .player__icon--play) {
		transform: scaleX(-1);
	}

	:global(.player__icon--pause),
	:global(.recording.is-playing .player__icon--play) {
		display: none;
	}

	:global(.recording.is-playing .player__icon--pause) {
		display: block;
	}

	:global(.player__time) {
		color: var(--color-brown);
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		min-inline-size: 3.4rem;
		text-align: center;
	}

	:global(.player__seek) {
		appearance: none;
		background: transparent;
		cursor: pointer;
		inline-size: 100%;
		min-inline-size: 8rem;
	}

	:global(.player__seek::-webkit-slider-runnable-track) {
		background: linear-gradient(90deg, var(--color-teal), var(--color-teal-dark));
		border-radius: var(--radius-pill);
		height: 0.35rem;
	}

	:global(.player__seek::-moz-range-track) {
		background: linear-gradient(90deg, var(--color-teal), var(--color-teal-dark));
		border-radius: var(--radius-pill);
		height: 0.35rem;
	}

	:global(.player__seek::-webkit-slider-thumb) {
		appearance: none;
		background: var(--color-white);
		border: 2px solid var(--color-teal-dark);
		border-radius: 50%;
		box-shadow: 0 0.2rem 0.45rem rgba(26, 43, 60, 0.18);
		height: 1rem;
		margin-top: -0.325rem;
		width: 1rem;
	}

	:global(.player__seek::-moz-range-thumb) {
		background: var(--color-white);
		border: 2px solid var(--color-teal-dark);
		border-radius: 50%;
		box-shadow: 0 0.2rem 0.45rem rgba(26, 43, 60, 0.18);
		height: 1rem;
		width: 1rem;
	}

	:global(.player__download) {
		border: 1px solid rgba(28, 125, 142, 0.42);
		border-radius: var(--radius-pill);
		color: var(--color-teal-dark);
		font-size: 0.88rem;
		font-weight: 700;
		padding: 0.35rem 0.85rem;
		text-decoration: none;
		white-space: nowrap;
	}

	:global(.player__download:hover) {
		background: var(--color-teal);
		border-color: var(--color-teal);
		color: var(--color-white);
	}

	@media (max-width: 38rem) {
		:global(.player) {
			grid-template-columns: 3rem 1fr auto;
		}

		:global(.player__time--current) {
			text-align: start;
		}

		:global(.player__seek) {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		:global(.player__download) {
			grid-column: 1 / -1;
			justify-self: start;
		}
	}
</style>
