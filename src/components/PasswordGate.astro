---
import type { Locale } from '../i18n';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;

const strings = {
	he: {
		heading: 'אזור מוגן',
		hint: 'הכניסה באמצעות סיסמה בלבד',
		placeholder: 'סיסמה',
		submit: 'כניסה',
		wrong: 'הסיסמה לא נכונה, כדאי לנסות שוב.',
	},
	en: {
		heading: 'Protected area',
		hint: 'Enter the password to continue',
		placeholder: 'Password',
		submit: 'Enter',
		wrong: 'Incorrect password — please try again.',
	},
};
const t = strings[locale];
---

<section class="gate">
	<div class="container gate-inner">
		<h1>{t.heading}</h1>
		<p>{t.hint}</p>
		<form id="gate-form" autocomplete="off">
			<input type="password" id="gate-password" name="password" placeholder={t.placeholder} required autocomplete="off" />
			<button type="submit">{t.submit}</button>
		</form>
		<p id="gate-error" class="gate-error" hidden>{t.wrong}</p>
	</div>
</section>

<div id="gate-payload" data-iv="__GATE_IV__" data-cipher="__GATE_CIPHER__" hidden></div>

<script>
	function base64ToBytes(b64: string): Uint8Array {
		return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
	}

	async function deriveKey(password: string): Promise<CryptoKey> {
		const keyMaterial = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(password));
		return crypto.subtle.importKey('raw', keyMaterial, 'AES-GCM', false, ['decrypt']);
	}

	async function tryUnlock(password: string): Promise<string | null> {
		const payload = document.getElementById('gate-payload');
		if (!payload) return null;
		const iv = base64ToBytes(payload.dataset.iv!);
		const cipher = base64ToBytes(payload.dataset.cipher!);
		try {
			const key = await deriveKey(password);
			const plainBuf = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, cipher);
			return new TextDecoder().decode(plainBuf);
		} catch {
			return null;
		}
	}

	function formatTime(seconds: number): string {
		if (!Number.isFinite(seconds)) return '0:00';
		const total = Math.max(0, Math.floor(seconds));
		const minutes = Math.floor(total / 60);
		const remainder = total % 60;
		return `${minutes}:${String(remainder).padStart(2, '0')}`;
	}

	class MeditationPlayerElement extends HTMLElement {
		connectedCallback() {
			const audio = this.querySelector('audio');
			const toggle = this.querySelector<HTMLButtonElement>('.player__toggle');
			const seek = this.querySelector<HTMLInputElement>('.player__seek');
			const current = this.querySelector<HTMLElement>('.player__time--current');
			const duration = this.querySelector<HTMLElement>('.player__time--duration');
			if (!audio || !toggle || !seek || !current || !duration) return;

			const playLabel = this.dataset.playLabel ?? 'Play';
			const pauseLabel = this.dataset.pauseLabel ?? 'Pause';

			const updateButton = () => {
				this.classList.toggle('is-playing', !audio.paused);
				toggle.setAttribute('aria-label', audio.paused ? playLabel : pauseLabel);
			};

			const updateProgress = () => {
				current.textContent = formatTime(audio.currentTime);
				if (Number.isFinite(audio.duration) && audio.duration > 0) {
					seek.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
				}
			};

			toggle.addEventListener('click', async () => {
				if (audio.paused) {
					for (const other of document.querySelectorAll<HTMLAudioElement>('meditation-player audio')) {
						if (other !== audio) other.pause();
					}
					try {
						await audio.play();
					} catch {
						updateButton();
					}
				} else {
					audio.pause();
				}
			});

			seek.addEventListener('input', () => {
				if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
				audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
			});

			audio.addEventListener('loadedmetadata', () => {
				duration.textContent = formatTime(audio.duration);
				updateProgress();
			});
			audio.addEventListener('timeupdate', updateProgress);
			audio.addEventListener('play', updateButton);
			audio.addEventListener('pause', updateButton);
			audio.addEventListener('ended', () => {
				seek.value = '0';
				updateButton();
			});

			updateButton();
			updateProgress();
		}
	}

	if (!customElements.get('meditation-player')) {
		customElements.define('meditation-player', MeditationPlayerElement);
	}

	const form = document.getElementById('gate-form') as HTMLFormElement | null;
	const errorEl = document.getElementById('gate-error');
	const passwordInput = document.getElementById('gate-password') as HTMLInputElement | null;

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const password = passwordInput?.value.trim() ?? '';
		const html = await tryUnlock(password);
		if (html === null) {
			errorEl?.removeAttribute('hidden');
			return;
		}
		document.body.innerHTML = html;
	});
</script>

<style>
	.gate {
		min-height: 60vh;
		display: flex;
		align-items: center;
	}
	.gate-inner {
		max-width: 24rem;
	}
	.gate h1 {
		margin-bottom: var(--space-1);
	}
	form {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}
	input[type='password'] {
		font: inherit;
		padding: 0.65rem 0.85rem;
		border: 1px solid rgba(92, 58, 24, 0.3);
		border-radius: 0.5rem;
		background: var(--color-white);
	}
	button[type='submit'] {
		align-self: flex-start;
		padding: 0.85rem 2rem;
		border-radius: var(--radius-pill);
		border: 2px solid var(--color-teal);
		background: var(--color-teal);
		color: var(--color-white);
		font-weight: 600;
		cursor: pointer;
	}
	button[type='submit']:hover {
		background: var(--color-teal-dark);
		border-color: var(--color-teal-dark);
	}
	.gate-error {
		color: #a13c3c;
		margin-top: var(--space-2);
	}
</style>
